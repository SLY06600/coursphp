# Ignorer les dossiers de dépendances
/vendor/
/node_modules/

# Ignorer les fichiers de logs
*.log

# Ignorer les fichiers temporaires
*.tmp
*.temp
*.cache

# Ignorer les fichiers générés par l’IDE
.idea/
.vscode/

# Ignorer les fichiers de configuration locaux
.env
.env.local
.env.*.local

# Ignorer les fichiers compilés (par exemple les OPCache)
*.opcache

# Ignorer les fichiers de session PHP
session.save_path

# Ignorer les fichiers upload temporaires
*.upload

# Ignorer les fichiers de cache et sessions (Symfony/Laravel)
var/cache/
var/log/
storage/logs/
storage/framework/cache/
storage/framework/sessions/

# Ignorer les fichiers SQLite (si utilisés en local)
*.sqlite
*.sqlite3
